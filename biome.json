{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "files": {
        "includes": [
            "frontend/**",
            "!**/node_modules",
            "!**/.next",
            "!**/package-lock.json",
            "!**/next-env.d.ts"
        ]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "json": {
        "formatter": { "indentWidth": 2 }
    },
    "linter": {
        "rules": {
            "recommended": true,
            "correctness": {
                "useExhaustiveDependencies": "warn"
            }
        }
    }
}
